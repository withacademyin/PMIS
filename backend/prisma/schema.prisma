datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  LEARNER
  RECRUITER
  ADMIN
}

enum RecruiterInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
  ACCEPTED
}

model SystemSettings {
  id                  Int      @id @default(1)
  allowedColleges     String[] @default([])
  allowedCourses      String[] @default([])
  allowedEmailDomains String[] @default([])
  updatedAt           DateTime @updatedAt
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  password         String
  role             Role              @default(LEARNER)
  createdAt        DateTime          @default(now())
  studentProfile   StudentProfile?
  recruiterProfile RecruiterProfile?
}

model Company {
  id          String             @id @default(uuid())
  name        String
  website     String?
  industry    String?
  location    String?
  description String?
  logoUrl     String?
  size        String?
  status      String             @default("ACTIVE")
  recruiters  RecruiterProfile[]
  invitations RecruiterInvitation[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model StudentProfile {
  id               String         @id @default(uuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id])
  fullName         String
  college          String
  degree           String?
  graduationYear   Int?
  isVerified       Boolean        @default(false)
  skills           String[]
  skillScores      Json           @default("{}")
  cheatingFlags    Int            @default(0)
  lastAssessmentAt DateTime?
  languages        String[]
  projectTypes     String[]
  certifications   String[]
  resumeUrl        String?
  contextBlob      String?
  applications     Application[]
  studentSkills    StudentSkill[]
}

model RecruiterProfile {
  id          String       @id @default(uuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id])
  companyName String
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id])
  isVerified  Boolean      @default(true)
  jobs        JobListing[]
}

model RecruiterInvitation {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  email       String
  role        Role      @default(RECRUITER)
  tokenHash   String
  status      RecruiterInvitationStatus @default(PENDING)
  invitedBy   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model JobListing {
  id             String           @id @default(uuid())
  title          String
  description    String
  jdText         String?
  recruiterId    String
  recruiter      RecruiterProfile @relation(fields: [recruiterId], references: [id])
  requiredSkills String[]
  applications   Application[]
  createdAt      DateTime         @default(now())
}

model Application {
  id            String            @id @default(uuid())
  studentId     String
  student       StudentProfile    @relation(fields: [studentId], references: [id])
  jobId         String
  job           JobListing        @relation(fields: [jobId], references: [id])
  status        ApplicationStatus @default(APPLIED)
  matchScore    Float?
  aiScore       Float?
  aiFeedback    String?
  interviewDate DateTime?
  interviewLink String?
  appliedAt     DateTime          @default(now())
  internship    Internship?

  @@unique([studentId, jobId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actor       String
  action      String
  entity      String
  entityId    String
  metadata    Json?
  timestamp   DateTime @default(now())
}

model CanonicalEntity {
  id             Int                    @id @default(autoincrement())
  canonical_name String
  type           String // skill, language, project_type, certification
  category       String?
  description    String?
  aliases        String[]
  embedding      Unsupported("vector")?
  is_active      Boolean                @default(true)
  studentSkills  StudentSkill[]
}

model StudentSkill {
  id         Int             @id @default(autoincrement())
  studentId  String
  student    StudentProfile  @relation(fields: [studentId], references: [id])
  entityId   Int
  entity     CanonicalEntity @relation(fields: [entityId], references: [id])
  status     String
  confidence Float
  evidence   String?
  source     String
}

enum InternshipStatus {
  ONBOARDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum KRAStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  CHANGES_REQUESTED
}

enum KRAPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Internship {
  id            String           @id @default(uuid())
  applicationId String           @unique
  application   Application      @relation(fields: [applicationId], references: [id])
  startDate     DateTime
  endDate       DateTime?
  status        InternshipStatus @default(ONBOARDING)
  kras          KRA[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model KRA {
  id            String        @id @default(uuid())
  internshipId  String
  internship    Internship    @relation(fields: [internshipId], references: [id])
  title         String
  description   String?
  startDate     DateTime
  dueDate       DateTime
  status        KRAStatus     @default(NOT_STARTED)
  priority      KRAPriority   @default(MEDIUM)
  progress      Int           @default(0)
  items         KRAItem[]
  submissions   KRASubmission[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model KRAItem {
  id          String   @id @default(uuid())
  kraId       String
  kra         KRA      @relation(fields: [kraId], references: [id])
  title       String
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KRASubmission {
  id          String   @id @default(uuid())
  kraId       String
  kra         KRA      @relation(fields: [kraId], references: [id])
  evidenceUrl String
  notes       String?
  status      String   @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED
  createdAt   DateTime @default(now())
}
