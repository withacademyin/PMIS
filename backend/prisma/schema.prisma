datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector, postgis]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  WORKER
  OFFICER
  ADMIN
}

enum OfficerInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ShortlistStatus {
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  ACCEPTED
  REJECTED
}

enum PlacementStatus {
  ONBOARDING
  ACTIVE
  COMPLETED
  CANCELLED
}

model SystemSettings {
  id                  Int      @id @default(1)
  allowedITIs         String[] @default([])
  allowedTrades       String[] @default([])
  allowedEmailDomains String[] @default([])
  updatedAt           DateTime @updatedAt
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  role           Role            @default(WORKER)
  createdAt      DateTime        @default(now())
  workerProfile  WorkerProfile?
  officerProfile OfficerProfile?
}

model ITI {
  id           String                               @id @default(uuid())
  name         String
  code         String?
  district     String
  state        String
  isGovernment Boolean                              @default(true)
  location     Unsupported("geography(Point,4326)")?
  description  String?
  status       String                               @default("ACTIVE")
  workers      WorkerProfile[]
  createdAt    DateTime                             @default(now())
  updatedAt    DateTime                             @updatedAt
}

model WorkerProfile {
  id                 String                               @id @default(uuid())
  userId             String                               @unique
  user               User                                 @relation(fields: [userId], references: [id])
  fullName           String
  itiId              String?
  iti                ITI?                                 @relation(fields: [itiId], references: [id])
  trade              String
  certificationGrade String?
  location           Unsupported("geography(Point,4326)")?
  availabilityStatus String                               @default("AVAILABLE")
  experienceYears    Int                                  @default(0)
  isVerified         Boolean                              @default(false)
  skills             String[]
  skillScores        Json                                 @default("{}")
  cheatingFlags      Int                                  @default(0)
  lastAssessmentAt   DateTime?
  languages          String[]
  certifications     String[]
  resumeUrl          String?
  contextBlob        String?
  shortlists         Shortlist[]
  workerSkills       WorkerSkill[]
  createdAt          DateTime                             @default(now())
  updatedAt          DateTime                             @updatedAt
}

model OfficerProfile {
  id           String            @id @default(uuid())
  userId       String            @unique
  user         User              @relation(fields: [userId], references: [id])
  name         String?
  district     String
  department   String?
  isVerified   Boolean           @default(true)
  requirements WorkRequirement[]
  shortlists   Shortlist[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model OfficerInvitation {
  id         String                  @id @default(uuid())
  district   String
  email      String
  role       Role                    @default(OFFICER)
  tokenHash  String
  status     OfficerInvitationStatus @default(PENDING)
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
}

model WorkRequirement {
  id            String         @id @default(uuid())
  title         String
  description   String
  jdText        String?
  officerId     String
  officer       OfficerProfile @relation(fields: [officerId], references: [id])
  requiredTrade String
  shortlists    Shortlist[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Shortlist {
  id            String           @id @default(uuid())
  workerId      String
  worker        WorkerProfile    @relation(fields: [workerId], references: [id])
  officerId     String
  officer       OfficerProfile   @relation(fields: [officerId], references: [id])
  requirementId String?
  requirement   WorkRequirement? @relation(fields: [requirementId], references: [id])
  status        ShortlistStatus  @default(SHORTLISTED)
  matchScore    Float?
  distanceM     Float?
  notes         String?
  shortlistedAt DateTime         @default(now())
  placement     Placement?
}

model Placement {
  id          String          @id @default(uuid())
  shortlistId String          @unique
  shortlist   Shortlist       @relation(fields: [shortlistId], references: [id])
  startDate   DateTime
  endDate     DateTime?
  status      PlacementStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  entity    String
  entityId  String
  metadata  Json?
  timestamp DateTime @default(now())
}

model TradeSkill {
  id             Int                    @id @default(autoincrement())
  canonical_name String
  type           String // skill, language, project_type, certification
  category       String?
  description    String?
  aliases        String[]
  embedding      Unsupported("vector")?
  is_active      Boolean                @default(true)
  workerSkills   WorkerSkill[]
}

model WorkerSkill {
  id           Int           @id @default(autoincrement())
  workerId     String
  worker       WorkerProfile @relation(fields: [workerId], references: [id])
  tradeSkillId Int
  tradeSkill   TradeSkill    @relation(fields: [tradeSkillId], references: [id])
  status       String
  confidence   Float
  evidence     String?
  source       String
}
